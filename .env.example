PORT=4000

# Signs/verifies JWTs in src/middleware/guard.js — required for guard to
# work at all (it throws a 500 if unset, on purpose, rather than silently
# accepting unsigned tokens).
JWT_SECRET=

# Optional separate key for HMAC-hashing OTP values at rest. If omitted,
# JWT_SECRET is used. Set a different long random value in production.
OTP_SECRET=

# Sends the registration OTP via Hostinger SMTP (nodemailer). Set all four
# in production or POST /api/auth/register will reject at the OTP-send step
# instead of pretending an email was sent; in non-production, if any are
# missing the OTP is logged to the console instead (see auth.controller.js's
# issueRegistrationOtp).
#
# Render's network was found to block outbound SMTP on ports 465 and 587
# entirely (connection-level timeout, regardless of credentials) — port 2525
# is being tried as a less-common alternative some hosts don't filter.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=WorkBridge <noreply@hanbee.in>

# "Continue with Google" (POST /api/auth/google) — the OAuth Client ID from
# a Google Cloud project's Credentials page (Web application type). No
# client secret needed here: the frontend uses Google Identity Services to
# get an ID token directly, and this only verifies that token server-side.
# Must match VITE_GOOGLE_CLIENT_ID in Frontend/.env.local exactly. If unset,
# the endpoint responds 500 and the frontend simply doesn't render the
# button — see auth.controller.js's getGoogleClient.
GOOGLE_CLIENT_ID=

# Not yet consumed — src/db/client.js is a stub until this exists.
# Matches the local Postgres from ../docker-compose.yml once it's running:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/workbridge_db
DATABASE_URL=

# Razorpay Route (payments.controller.js / razorpay.service.js) — from the
# Razorpay Dashboard's Account & Settings > API Keys. Use rzp_test_* keys
# while developing; the code doesn't care which mode a key is, Razorpay
# routes test vs. live money based on the key prefix alone. If unset, the
# payment endpoints respond 500 rather than silently misbehaving — same
# "optional, fails loud" convention as VAPID_* above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the same Dashboard section's Webhooks tab, after creating a webhook
# pointing at POST /api/payments/webhook — this signs/verifies that
# webhook calls actually came from Razorpay (see webhook.controller.js).
RAZORPAY_WEBHOOK_SECRET=

# Local/test only: admin withdrawal approval returns a simulated successful
# RazorpayX payout and stores its fake payout id. Production uses the real
# RazorpayX API unless this is explicitly enabled.
RAZORPAYX_MOCK=true
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Cashfree Payment Gateway (pay-in — see cashfree.service.js). From the
# Cashfree Dashboard's Developers > API Keys. Sandbox App IDs are prefixed
# TEST... — cashfree.service.js keys off that prefix to pick the sandbox
# vs production PG API host, so no separate env/mock flag is needed here.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Cashfree Payouts (worker payouts) — a SEPARATE product/credential pair
# from the PG keys above, confirmed 2026-08-27 (PG credentials 404 against
# the Payouts API). Client ID has no TEST prefix even for sandbox, so
# CASHFREE_PAYOUT_ENV (TEST | PRODUCTION) is what actually picks the host.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_ENV=TEST
